{
  "name": "barberia-elegance",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "serve . -p 3000 --no-clipboard",
    "start": "serve . -p 3000",
    "build": "cd admin-panel && npm install && npm run build",
    "build:css": "tailwindcss -i input.css -o output.css --minify && tailwindcss -c tailwind-lookbook.config.js -i input.css -o output-lookbook.css --minify",
    "build:css:watch": "tailwindcss -i input.css -o output.css --watch",
    "seed": "node seed-barberos.js",
    "check:mojibake": "node scripts/check-mojibake.js",
    "check:tenants": "node scripts/check-tema-tenants.js",
    "check:bot-prompt": "node scripts/check-bot-prompt.js",
    "check:rutas-admin": "node scripts/check-rutas-admin.js",
    "check": "npm run check:mojibake && npm run check:tenants && npm run check:agenda && npm run check:slotlocks && npm run check:wa-plan && npm run check:wa-optin && npm run check:wallet-cors && npm run check:rutas-admin && npm run test:alerta-sesion && npm run test:gasto-ia && npm run test:mailer && npm run test:link-legacy && npm run test:reagendar && npm run test:duracion && npm run test:cinturon-dia && npm run test:cinturon-accion && npm run test:cambio-hora && npm run test:caja-gastos && npm run test:sede-gateway && npm run check:tema-claro && npm run check:espejos-claros",
    "check:espejos-claros": "node scripts/check-espejos-claros.js",
    "test:rules": "firebase emulators:exec --only firestore \"node scripts/test-rules-roles.js\"",
    "check:agenda": "node scripts/check-agenda-visibles.js",
    "test:cancelar": "firebase emulators:exec --only firestore \"node scripts/test-rules-cancelar-cliente.js\"",
    "test:booking-abuse": "firebase emulators:exec --only firestore \"node scripts/test-rules-booking-abuse.js\"",
    "test:idor": "firebase emulators:exec --only firestore \"node scripts/test-rules-idor.js\"",
    "test:storage": "firebase emulators:exec --only storage,firestore \"node scripts/test-storage-rules.js\"",
    "test:hardening": "firebase emulators:exec --only firestore \"node scripts/test-rules-hardening.js\"",
    "check:slotlocks": "node scripts/auditar-slotlocks.js ALL 30",
    "test:slotlocks": "node scripts/test-auditor-slotlocks.js",
    "test:mailer": "node scripts/test-mailer.js",
    "check:wa-plan": "node scripts/check-wa-plan.js",
    "check:wa-optin": "node scripts/check-wa-optin.js",
    "check:wallet-cors": "node scripts/check-wallet-cors.js",
    "test:alerta-sesion": "node scripts/test-alerta-sesion.js",
    "test:gasto-ia": "node scripts/test-gasto-ia.js",
    "test:link-legacy": "node scripts/test-link-legacy.js",
    "test:reagendar": "node scripts/test-reagendar-bot.js",
    "test:dedupe-barberos": "node scripts/test-dedupe-barberos.js",
    "test:duracion": "node scripts/test-duracion-tipica.js",
    "check:tema-claro": "node scripts/check-tema-claro.js",
    "test:bot": "node scripts/probar-bot.js",
    "test:cinturon-dia": "node scripts/test-cinturon-dia.js",
    "test:caja-gastos": "node scripts/test-caja-gastos-dia.js",
    "test:sede-gateway": "node scripts/test-sede-gateway.js",
    "test:cinturon-accion": "node scripts/test-cinturon-accion.js",
    "check:bot": "npm run test:reagendar && npm run test:duracion && npm run test:cinturon-dia && npm run test:cinturon-accion && npm run test:sede-gateway && npm run test:cambio-hora && npm run test:medianoche",
    "check:citas": "node scripts/auditar-citas-imposibles.js ALL 60",
    "test:cambio-hora": "node scripts/test-cambio-hora-chile.js",
    "test:medianoche": "node scripts/test-jornada-medianoche.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "csv-parse": "^7.0.0",
    "firebase": "^12.16.0",
    "firebase-admin": "^13.8.0",
    "playwright": "^1.61.1",
    "serve": "^14.2.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0"
  }
}
