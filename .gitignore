.vercel
node_modules/
functions/node_modules/
functions/package-lock.json
service-account.json
ferraza-service-account.json
*-service-account.json
seed-*creds*.js
scripts/creds-*.js
.claude/
firebase-debug.log
firestore-debug.log
*.pdf
admin-panel/.env*.local
scratch/

/bio/

# Build outputs
dist/

# Test/debug screenshots en la raíz
/error.png
/restodemo-*.png

# Logs de import batch (scripts/import-*-<timestamp>.jsonl/.stats.json)
scripts/import-*.jsonl
scripts/import-*.stats.json

# Salidas de los scripts de auditoría (scripts/audit-<tenant>-<timestamp>.json).
# Son artefactos de una corrida, no fuente.
scripts/audit-*.json

# Scripts de un solo uso: rutas absolutas hardcodeadas y se despliegan con
# las functions sin que nadie los importe.
functions/_temp-*.js

# Herramientas ad-hoc de diagnostico/backfill (prefijo `_`) — nunca se
# importan desde el resto del codigo, viven en local y se tiran.
functions/_*.mjs
# Respaldos que dejan los scripts _*.mjs antes de tocar datos. Llevan datos
# personales de clientes (nombre, mail, teléfono) — nunca al repo.
functions/_*.json
functions/_snapshots/
/_*.mjs
admin-panel/_*.mjs

# CSVs de backfill/import: suelen tener datos de clientes reales
# (nombres, telefonos, citas). Nunca versionar.
functions/*.csv

# Artifacts del MCP server de Playwright (cache y screenshots temporales).
.playwright-mcp/

# Scripts de alta de accesos: llevan contrasenas en texto plano.
# El repo es PUBLICO -- nunca versionar credenciales.
scripts/crear-admin-*sion*.js
scripts/creds-*.js
scripts/crear-accesos-*.js
