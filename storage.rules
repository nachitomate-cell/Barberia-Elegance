rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuth()      { return request.auth != null; }
    function isImage()     { return request.resource.contentType.matches('image/.*'); }
    function isUnder5MB()  { return request.resource.size < 5 * 1024 * 1024; }
    function isUnder10MB() { return request.resource.size < 10 * 1024 * 1024; }

    // ── Autorización de escritura por tenant ─────────────────────────────
    // Antes casi todo era `isAuth()`: cualquier usuario autenticado (y el club
    // es de registro abierto) podía SOBRESCRIBIR logo, fotos de barberos,
    // banners, menú y assets de Wallet de CUALQUIER local (defacement) e inflar
    // el storage (costo Blaze). Ahora los assets de marca exigen staff del
    // tenant. Espeja esStaff() de firestore.rules. Auditoría 2026-08-05.
    function rol()    { return isAuth() && 'role'     in request.auth.token ? request.auth.token.role     : ''; }
    function tclaim() { return isAuth() && 'tenantId' in request.auth.token ? request.auth.token.tenantId : ''; }
    function esBootstrap() {
      return isAuth() && 'email' in request.auth.token
          && request.auth.token.email == 'ignaciiio.mate@gmail.com';
    }
    function esStaffClaim(tid) {
      return isAuth() && tclaim() == tid
          && (rol() == 'admin' || rol() == 'jefe' || rol() == 'barbero' || rol() == 'recepcion');
    }
    // Fallback pre-claims (barberos que aún no tienen Custom Claims): su doc existe.
    function esBarberoFS(tid) {
      return isAuth() && (
        tid == 'elegance'
          ? firestore.exists(/databases/(default)/documents/barberos/$(request.auth.uid))
          : firestore.exists(/databases/(default)/documents/tenants/$(tid)/barberos/$(request.auth.uid))
      );
    }
    // Espejo de esKronnosBrandAdmin de firestore.rules: los dueños de la marca
    // administran las 4 sedes con claims de UNA sola (kronnos_limache). Sin
    // este espejo, Firestore los deja editar un barbero de otra sede pero
    // Storage les niega la foto (storage/unauthorized). Pasó con Claudio
    // subiendo la foto de Kelly (kronnos_woman) el 07-08-2026.
    function esKronnosBrandAdmin(tid) {
      return isAuth() && 'email' in request.auth.token
          && request.auth.token.email in [
               'administracionkronnos@gmail.com',
               'claudio.burgos91@gmail.com',
               'grupo.kratos.spa@gmail.com'
             ]
          && tid in ['kronnos', 'kronnos_penablanca', 'kronnos_limache', 'kronnos_woman'];
    }
    function esStaff(tid) { return esStaffClaim(tid) || esBootstrap() || esKronnosBrandAdmin(tid) || esBarberoFS(tid); }

    // ═══ Rutas de USUARIO — cada quien sube lo suyo ═══════════════════════

    // Fotos de perfil de clientes — cada usuario sube solo a su propio uid
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isAuth() && request.auth.uid == userId && isImage() && isUnder5MB();
    }

    // Imágenes del chat público (/chat) — el cliente sube solo a SU carpeta.
    match /chat/{tenantId}/{userId}/{fileName} {
      allow read: if true;
      allow write: if isAuth() && request.auth.uid == userId && isImage() && isUnder5MB();
    }

    // Servicio Favorito: el dueño (su uid) o el staff del local.
    match /servicioFavorito/{userId}/{fileName} {
      allow read: if true;
      allow write: if (request.auth.uid == userId || esStaff('elegance')) && isImage() && isUnder5MB();
    }
    match /tenants/{tenantId}/avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isAuth() && request.auth.uid == userId && isImage() && isUnder5MB();
    }
    match /tenants/{tenantId}/servicioFavorito/{userId}/{fileName} {
      allow read: if true;
      allow write: if (request.auth.uid == userId || esStaff(tenantId)) && isImage() && isUnder5MB();
    }

    // ═══ Assets de MARCA / contenido — solo staff del local ═══════════════

    // Fotos de perfil de barberos
    match /barberos/{imageId} {
      allow read: if true;
      allow write: if esStaff('elegance') && isImage() && isUnder5MB();
    }
    // Galería lookbook (elegance root)
    match /lookbook/{imageId} {
      allow read: if true;
      allow write: if esStaff('elegance') && isImage() && isUnder10MB();
    }
    // Productos (elegance root)
    match /productos/{imageId} {
      allow read: if true;
      allow write: if esStaff('elegance') && isImage() && isUnder5MB();
    }
    // Servicios (elegance root)
    match /servicios/{servicioId}/{fileName} {
      allow read: if true;
      allow write: if esStaff('elegance') && isImage() && isUnder5MB();
    }
    // Assets del local (logo, fondo, etc.)
    match /assets/{imageId} {
      allow read: if true;
      allow write: if esStaff('elegance') && isImage() && isUnder5MB();
    }
    // Banners/campañas de Marketing (elegance root)
    match /marketing/{imageId} {
      allow read: if true;
      allow write: if esStaff('elegance') && isImage() && isUnder5MB();
    }

    // Creativos del Instagram DE LA PLATAFORMA (@synaptechspa).
    //
    // No es de ningún tenant: es la cuenta de SynapTech, así que el permiso es
    // el del operador de plataforma y no el staff de un local.
    //
    // `read: if true` es OBLIGATORIO y no un descuido: Instagram descarga la
    // media desde SUS servidores, sin credenciales nuestras. Una URL privada
    // hace que la publicación falle con un error que no dice esto.
    // 15 MB porque acá también entran reels, que pesan bastante más que una
    // foto; el resto de las rutas son solo imágenes.
    match /instagram_creativos/{fileName} {
      allow read: if true;
      allow write: if esBootstrap()
                   && request.resource.size < 15 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('video/.*'));
    }

    // ── Multi-tenant ─────────────────────────────────────────────────────
    match /tenants/{tenantId}/barberos/{imageId} {
      allow read: if true;
      allow write: if esStaff(tenantId) && isImage() && isUnder5MB();
    }
    match /tenants/{tenantId}/lookbook/{imageId} {
      allow read: if true;
      allow write: if esStaff(tenantId) && isImage() && isUnder10MB();
    }
    match /tenants/{tenantId}/productos/{imageId} {
      allow read: if true;
      allow write: if esStaff(tenantId) && isImage() && isUnder5MB();
    }
    match /tenants/{tenantId}/marketing/{imageId} {
      allow read: if true;
      allow write: if esStaff(tenantId) && isImage() && isUnder5MB();
    }
    // Fondo de BarberTV (puede ser imagen o video → sin isImage; cap alto).
    // Antes cualquier autenticado podía subir 100MB al TV de otro local.
    match /tenants/{tenantId}/{fileName} {
      allow read: if fileName.matches('tv-bg\\..*');
      allow write: if esStaff(tenantId)
                   && fileName.matches('tv-bg\\..*')
                   && request.resource.size < 100 * 1024 * 1024;
    }
    match /tenants/{tenantId}/publicidad_tv/{imageId} {
      allow read: if true;
      allow write: if esStaff(tenantId) && isImage() && isUnder10MB();
    }
    match /tenants/{tenantId}/servicios/{servicioId}/{fileName} {
      allow read: if true;
      allow write: if esStaff(tenantId) && isImage() && isUnder5MB();
    }
    // Menú (tenants tipo restaurante) — fotos de platos desde el panel.
    match /tenants/{tenantId}/menu/{itemId}/{fileName} {
      allow read: if true;
      allow write: if esStaff(tenantId) && isImage() && isUnder5MB();
    }
    // Wallo — assets de la tarjeta de fidelidad (logo + banner del local).
    match /tenants/{tenantId}/wallo/{fileName} {
      allow read: if true;
      allow write: if esStaff(tenantId) && isImage() && isUnder5MB();
    }

    // Bloquear cualquier otra ruta
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
