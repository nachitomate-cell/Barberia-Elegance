# ─────────────────────────────────────────────────────────────────
# .env.example — plantilla de secretos usados por Cloud Functions.
#
# En producción, cada valor se guarda como Firebase Secret con:
#   firebase functions:secrets:set NOMBRE
# y se referencia en la Function vía defineSecret('NOMBRE'). NO se
# leen desde este archivo — es solo referencia para nuevos entornos.
#
# Para desarrollo local con emuladores, copiar a functions/.secret.local
# (ese sí se lee y está gitignoreado).
# ─────────────────────────────────────────────────────────────────

# ── API server-to-server para el asistente financiero SynapTech ─
# Bearer que autoriza a los endpoints de solo-lectura:
#   GET /api/v1/finances    → cuotas pendientes del mes  (finance-api.js)
#   GET /api/v1/ops-summary → costos + trials + activos  (ops-summary-api.js)
# Una sola key para ambos; rotar juntos.
# Generar con: openssl rand -hex 32
SYNAPTECH_FINANCE_API_KEY=

# ── Mercado Pago — cuenta SynapTech (app bioo12), NO Yügen ──────
# Suscripciones de la mensualidad + cobros bioo. Dueño real: SynapTech Spa.
MP_PLATFORM_ACCESS_TOKEN=

# ── Mercado Pago — cuenta Yügen (app 4270046524878802, Dusan) ──
# Solo para los cobros públicos de Yügen. NO mezclar con la mensualidad.
MP_ACCESS_TOKEN=

# ── Resend (email transaccional: comprobantes, avisos de cobro) ─
RESEND_API_KEY=
